<!doctype html>
<html lang="{{ locale|default('cs') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject|default('MyPortfolio') }}</title>
<style>
  /* Mobil: e-mail přes celou šířku displeje (klienti bez podpory <style> mají menší okraje i bez toho). */
  @media only screen and (max-width: 600px) {
    .mp-outer { padding: 0 !important; }
    .mp-card { border-radius: 0 !important; border-left: 0 !important; border-right: 0 !important; }
    .mp-head { padding: 16px !important; }
    .mp-body { padding: 20px 16px !important; }
  }
</style>
</head>
{# Barvy podle tokenů aplikace (web/src/styles/main.css, světlý motiv) #}
{% set accent = '#1B7138' %}
{% set accent_soft = '#EFFAF0' %}
{% set brand_text = '#115B2B' %}
<body style="margin:0;padding:0;background:#F0F5F1;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111512;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mp-outer" style="background:#F0F5F1;padding:24px 4px;">
  <tr>
    <td align="center">

      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mp-card" style="max-width:560px;background:#ffffff;border:1px solid #E3E8E3;border-radius:12px;overflow:hidden;">
        <tr>
          <td class="mp-head" style="padding:18px 24px;border-bottom:1px solid #E3E8E3;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                {# Logo jako vložený PNG (cid:) — SVG ani data URI Gmail / Outlook nezobrazí; podklad = barva značky, kdyby klient obrázek skryl #}
                <td style="vertical-align:middle;width:40px;">
                  <img src="{{ logo_src }}" width="40" height="40" alt="" style="display:block;width:40px;height:40px;border:0;border-radius:9px;background:{{ accent }};">
                </td>
                <td style="vertical-align:middle;padding-left:12px;">
                  <div style="font-size:18px;font-weight:700;color:#111512;line-height:1.2;letter-spacing:-.01em;">My<span style="color:{{ brand_text }};">Portfolio</span></div>
                  <div style="font-size:12px;color:#707470;line-height:1.4;margin-top:2px;">{{ locale == 'en' ? 'Investment tracker' : 'Přehled investic' }}</div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td class="mp-body" style="padding:24px;font-size:15px;line-height:1.6;color:#3D413D;">
            {% block content %}{% endblock %}
          </td>
        </tr>
      </table>

      <p style="max-width:560px;font-size:11px;color:#A1A6A2;margin:16px auto 0;text-align:center;">
        {% if locale == 'en' %}
          This email was sent automatically. If you did not request it, you can ignore it.
        {% else %}
          Tento email byl odeslán automaticky. Pokud jste o něj nežádali, můžete ho ignorovat.
        {% endif %}
      </p>

    </td>
  </tr>
</table>

</body>
</html>
