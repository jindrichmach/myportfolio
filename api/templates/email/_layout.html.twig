<!doctype html>
<html lang="{{ locale|default('cs') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject|default('MyPortfolio') }}</title>
<style>
  /* Mobil: e-mail přes celou šířku displeje (klienti bez podpory <style> mají menší okraje i bez toho). */
  @media only screen and (max-width: 600px) {
    .mp-outer { padding: 0 !important; }
    .mp-card { border-radius: 0 !important; border-left: 0 !important; border-right: 0 !important; }
    .mp-head { padding: 16px !important; }
    .mp-body { padding: 20px 16px !important; }
  }
</style>
</head>
{% set accent = '#3B2D83' %}
{% set accent_soft = '#F4F2FB' %}
<body style="margin:0;padding:0;background:#F4F2F8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#15131D;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mp-outer" style="background:#F4F2F8;padding:24px 4px;">
  <tr>
    <td align="center">

      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mp-card" style="max-width:560px;background:#ffffff;border:1px solid #E7E3EE;border-radius:12px;overflow:hidden;">
        <tr>
          <td class="mp-head" style="padding:20px 24px;background:linear-gradient(180deg,{{ accent_soft }} 0%,#ffffff 100%);">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td style="vertical-align:middle;width:36px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:36px;height:36px;background:{{ accent }};border-radius:8px;">
                    <tr>
                      <td align="center" valign="middle" style="color:#ffffff;font-weight:700;font-size:20px;line-height:36px;font-family:Arial,sans-serif;">M</td>
                    </tr>
                  </table>
                </td>
                <td style="vertical-align:middle;padding-left:12px;">
                  <div style="font-size:18px;font-weight:600;color:#15131D;line-height:1.2;">My<span style="color:{{ accent }};">Portfolio</span></div>
                  <div style="font-size:12px;color:#7A748C;line-height:1.4;margin-top:2px;">{{ locale == 'en' ? 'Investment tracker' : 'Přehled investic' }}</div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td class="mp-body" style="padding:24px;font-size:15px;line-height:1.6;color:#403B52;">
            {% block content %}{% endblock %}
          </td>
        </tr>
      </table>

      <p style="max-width:560px;font-size:11px;color:#A7A0BA;margin:16px auto 0;text-align:center;">
        {% if locale == 'en' %}
          This email was sent automatically. If you did not request it, you can ignore it.
        {% else %}
          Tento email byl odeslán automaticky. Pokud jste o něj nežádali, můžete ho ignorovat.
        {% endif %}
      </p>

    </td>
  </tr>
</table>

</body>
</html>
