{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#111512;">{{ owner_name }} shares a portfolio with you</h1>

<p style="margin:0 0 16px;"><strong>{{ owner_name }}</strong> shared their data with you in <strong>MyPortfolio</strong> ({{ scope_text }}, {{ permission_text }}).</p>

<p style="margin:24px 0;text-align:center;">
  <a href="{{ link }}" style="display:inline-block;background:{{ accent }};color:#ffffff;text-decoration:none;font-weight:600;padding:12px 28px;border-radius:6px;font-size:15px;">
    Open MyPortfolio
  </a>
</p>

<p style="margin:0;font-size:12px;color:#555956;word-break:break-all;background:#F0F5F1;padding:10px;border-radius:6px;font-family:monospace;">
  {{ link }}
</p>

<p style="margin:24px 0 0;font-size:13px;color:#707470;">Switch to the shared data using the selector in the app header. You can leave the share anytime in Account → Sharing.</p>
{% endblock %}
