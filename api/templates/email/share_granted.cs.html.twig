{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#18181b;">{{ owner_name }} s Vámi sdílí portfolio</h1>

<p style="margin:0 0 16px;"><strong>{{ owner_name }}</strong> Vám v <strong>MyPortfolio</strong> nasdílel(a) svá data ({{ scope_text }}, {{ permission_text }}).</p>

<p style="margin:24px 0;text-align:center;">
  <a href="{{ link }}" style="display:inline-block;background:{{ accent }};color:#ffffff;text-decoration:none;font-weight:600;padding:12px 28px;border-radius:6px;font-size:15px;">
    Otevřít MyPortfolio
  </a>
</p>

<p style="margin:0;font-size:12px;color:#52525b;word-break:break-all;background:#f4f4f5;padding:10px;border-radius:6px;font-family:monospace;">
  {{ link }}
</p>

<p style="margin:24px 0 0;font-size:13px;color:#71717a;">Sdílená data zobrazíte přepínačem v záhlaví aplikace. Sdílení můžete kdykoli opustit v Účet → Sdílení.</p>
{% endblock %}
