{% extends '_layout.html.twig' %}

{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:{{ c.text }};">Zkušební e-mail</h1>
<p style="margin:0 0 16px;">Odesílání e-mailů z <strong>MyPortfolio</strong> funguje.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="font-size:13px;color:{{ c.secondary }};">
  <tr><td style="padding:2px 12px 2px 0;">Server</td><td><strong>{{ host }}:{{ port }}</strong> ({{ encryption }})</td></tr>
  <tr><td style="padding:2px 12px 2px 0;">Odesílatel</td><td>{{ from_email }}</td></tr>
  <tr><td style="padding:2px 12px 2px 0;">Odesláno</td><td>{{ sent_at }}</td></tr>
</table>
{% endblock %}
