# Docker Compose — vzor pro .env (cmd/docker-install.sh ho vygeneruje sám s náhodnými hesly).
# cp .env.example .env a doplň hesla: openssl rand -base64 24

# Port aplikace na hostiteli
APP_PORT=8080
# MariaDB je publikovaná jen na 127.0.0.1 hostitele (docker-compose.yml)
DB_PORT=3308
DB_NAME=myportfolio
DB_USER=myportfolio
DB_PASSWORD=CHANGE-ME
DB_ROOT_PASSWORD=CHANGE-ME

# Volitelné
# DB_INNODB_BUFFER_POOL=128M
# DB_INNODB_LOG_SIZE=48M
# 0 = vypne vestavěný cron v kontejneru
# MYPORTFOLIO_ENABLE_CRON=1
# MYPORTFOLIO_AUTH_REQUIRE_MFA=
# MYPORTFOLIO_AUTH_MFA_METHODS=
# MYPORTFOLIO_AUTH_PASSWORDLESS_LOGIN=
# MYPORTFOLIO_SESSION_LOCK_AFTER_MINUTES=
